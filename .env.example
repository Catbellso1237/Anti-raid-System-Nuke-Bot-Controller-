# Sao chép file này thành ".env" và điền thông tin thật vào.
# KHÔNG BAO GIỜ commit file ".env" thật lên GitHub public!

# Token của bot (lấy tại https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# ID kênh dùng để ghi log cảnh báo (chuột phải vào kênh -> Copy Channel ID)
LOG_CHANNEL_ID=123456789012345678

# (Tùy chọn) Webhook URL để gửi cảnh báo ra ngoài Discord (ví dụ: sang server dự phòng)
ALERT_WEBHOOK_URL=

# Danh sách ID chủ sở hữu / admin thật sự được TIN TƯỞNG TUYỆT ĐỐI, cách nhau bằng dấu phẩy
# Bất kỳ ai KHÔNG có trong danh sách này mà thực hiện hành động nguy hiểm sẽ bị chặn tự động
TRUSTED_IDS=111111111111111111,222222222222222222

# Ngưỡng số hành động nguy hiểm trong khoảng thời gian (giây) trước khi bot tự khóa server
ACTION_THRESHOLD=3
ACTION_WINDOW_SECONDS=10
